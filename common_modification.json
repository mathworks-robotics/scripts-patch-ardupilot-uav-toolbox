        {
          "line": 473,
          "type": "insert",
          "tag": "serialplant-serial-methods",
          "code": [
            "/* ===== serial plant methods (only compiled on ChibiOS with SERIALPLANT flag) ===== */",
            "",
            "#if HAL_SIM_SERIALPLANT_ENABLED",
            "",
            "void JSON::serial_init_uart()",
            "{",
            "    serial_uart = hal.serial(serial_port);",
            "    if (serial_uart == nullptr) {",
            "        printf(\"SerialPlant: SERIAL%u not available!\\n\", serial_port);",
            "        return;",
            "    }",
            "",
            "    if (serial_port != 0) {",
            "        serial_uart->set_unbuffered_writes(true);",
            "        serial_uart->begin(serial_baud, 2048, 2048);",
            "    } else {",
            "        serial_uart->begin(serial_baud);",
            "    }",
            "    serial_uart->configure_parity(serial_parity);",
            "    serial_uart->set_stop_bits(serial_stop_bits);",
            "    if (serial_hw_flow) {",
            "        serial_uart->set_flow_control(AP_HAL::UARTDriver::FLOW_CONTROL_ENABLE);",
            "    }",
            "    serial_uart->flush();",
            "    printf(\"SerialPlant: SERIAL%u initialized at %u baud parity=%u stopbits=%u hwflow=%u\\n\",",
            "           serial_port, (unsigned)serial_baud, serial_parity, serial_stop_bits, (unsigned)serial_hw_flow);",
            "}",
            "",
            "void JSON::serial_output_servos(const struct sitl_input &input)",
            "{",
            "    if (serial_uart == nullptr) {",
            "        serial_init_uart();",
            "        if (serial_uart == nullptr) {",
            "            return;",
            "        }",
            "    }",
            "",
            "    serial_num_channels = SRV_Channels::have_32_channels() ? 32 : 16;",
            "",
            "    uint8_t frame_buf[HEADER_SIZE + SERVO_32_LEN];",
            "",
            "    uint16_t total = encode_servo_frame(",
            "        input.servos, serial_num_channels,",
            "        frame_counter, (uint16_t)rate_hz,",
            "        frame_buf, sizeof(frame_buf));",
            "",
            "    if (total > 0) {",
            "        serial_uart->write(frame_buf, total);",
            "    }",
            "}",
            "",
            "void JSON::serial_poll_incoming()",
            "{",
            "    if (serial_uart == nullptr) {",
            "        return;",
            "    }",
            "",
            "    uint32_t available = serial_uart->available();",
            "    while (available-- > 0) {",
            "        uint8_t b;",
            "        if (serial_uart->read(&b, 1) != 1) {",
            "            break;",
            "        }",
            "        rx_feed_byte(&serial_rx_ctx, b);",
            "    }",
            "}",
            "",
            "void JSON::serial_apply_state_to_fdm(const struct decoded_state *ds)",
            "{",
            "    accel_body = Vector3f(ds->accel_body[0], ds->accel_body[1], ds->accel_body[2]);",
            "    gyro = Vector3f(ds->gyro[0], ds->gyro[1], ds->gyro[2]);",
            "    velocity_ef = Vector3f(ds->velocity[0], ds->velocity[1], ds->velocity[2]);",
            "    position = Vector3d(ds->position[0], ds->position[1], ds->position[2]);",
            "    position.xy() += origin.get_distance_NE_double(home);",
            "",
            "    if (ds->mask & MASK_QUATERNION) {",
            "        Quaternion quat(ds->quaternion[0], ds->quaternion[1], ds->quaternion[2], ds->quaternion[3]);",
            "        quat.rotation_matrix(dcm);",
            "    } else {",
            "        dcm.from_euler(ds->attitude[0], ds->attitude[1], ds->attitude[2]);",
            "    }",
            "",
            "    if (ds->mask & MASK_RANGEFINDER) {",
            "        for (uint8_t i = 0; i < 6; i++) {",
            "            rangefinder_m[i] = ds->rangefinder[i];",
            "        }",
            "    }",
            "",
            "    if (ds->mask & MASK_AIRSPEED) {",
            "        airspeed = ds->airspeed;",
            "        airspeed_pitot = ds->airspeed;",
            "    } else {",
            "        velocity_air_ef = velocity_ef;",
            "        velocity_air_bf = dcm.transposed() * velocity_air_ef;",
            "        update_eas_airspeed();",
            "    }",
            "",
            "    if (ds->mask & MASK_WINDVANE) {",
            "        wind_vane_apparent.direction = ds->windvane_direction;",
            "        wind_vane_apparent.speed = ds->windvane_speed;",
            "    }",
            "",
            "    update_position();",
            "",
            "    if (ds->timestamp_s < last_timestamp_s) {",
            "        printf(\"Old timestamp received at SerialPlant.\\n\");",
            "        last_timestamp_s = ds->timestamp_s;",
            "        return;",
            "    }",
            "",
            "    const double dt = ds->timestamp_s - last_timestamp_s;",
            "    last_timestamp_s = ds->timestamp_s;",
            "    time_now_us += dt * 1.0e6;",
            "",
            "    if (!is_positive(dt) || dt >= 0.05) {",
            "        return;",
            "    }",
            "    adjust_frame_time(1.0 / dt);",
            "    time_advance();",
            "}",
            "",
            "#endif  // HAL_SIM_SERIALPLANT_ENABLED"
          ]
        }
      ]
